[2026-10-26T09:20:49.994285645+01:00] tool_result: read_file: // Tower of Hanoi solver
function solveHanoi(n, from = 'A', to = 'C', via = 'B') {
  const pegs = { A: [], B: [], C: [] };
  for (let i = n; i >= 1; i--) pegs[from].push(i);
  const moves = [];

  function move(k, a, b, c) {
    if (k === 0) return;
    move(k - 1, a, c, b);
    const disk = pegs[a].pop();
    if (pegs[b].length && pegs[b][pegs[b].length - 1] < disk) {
      throw new Error(`Illegal move: disk ${disk} onto smaller disk`);
    }
    pegs[b].push(disk);
    moves.push({ disk, from: a, to: b });
    move(k - 1, c, b, a);
  }

  move(n, from, to, via);
  return { moves, pegs };
}

function main() {
  const n = parseInt(process.argv[2] ?? '3', 10);
  if (!Number.isInteger(n) || n < 1) {
    console.error('Usage: node hanoi.js <number of disks >= 1>');
    process.exit(1);
  }
  const { moves, pegs } = solveHanoi(n);
  moves.forEach((m, i) => console.log(`Move ${i + 1}: disk ${m.disk} from ${m.from} to ${m.to}`));
  console.log(`Total moves: ${moves.length} (expected ${2 ** n - 1})`);
  console.log('Final state:', JSON.stringify(pegs));
}

if (require.main === module) main();
module.exports = { solveHanoi };

